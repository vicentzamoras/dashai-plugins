{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "index.schema.json",
  "title": "Índice de la tienda que lee dashAI (index.json, lo genera el bot)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "built_at",
    "plugins",
    "removed",
    "revoked"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "built_at": {
      "type": "string",
      "format": "date-time"
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "location",
          "name",
          "authors",
          "components",
          "component_types",
          "releases",
          "license"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "source": {
            "type": "string",
            "description": "Un PluginSource de dashAI (hoy: git)"
          },
          "location": {
            "type": "string",
            "pattern": "^https://"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "email": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              }
            }
          },
          "components": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "component_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "releases": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tag",
                "version",
                "min_app_version",
                "trust_level",
                "sha256",
                "commit",
                "published_at",
                "artifact"
              ],
              "properties": {
                "tag": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "min_app_version": {
                  "type": "string"
                },
                "trust_level": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "published_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "dependencies": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "plugin_dependencies": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Los ids de otros plugins de la tienda que necesita (su manifest), cada uno con un rango de versión opcional, como nlp-core>=1.0"
                },
                "commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$",
                  "description": "El commit revisado: dashAI muestra el README de ahí"
                },
                "workflow": {
                  "type": "string",
                  "description": "Solo github_attested: el workflow que lo construyó"
                },
                "signed_at": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Solo github_attested"
                },
                "artifact": {
                  "description": "Lo que dashAI descarga: el archivo de la release o el código en commit",
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind",
                        "url",
                        "size"
                      ],
                      "properties": {
                        "kind": {
                          "const": "asset"
                        },
                        "url": {
                          "type": "string",
                          "pattern": "^https://"
                        },
                        "size": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 209715200
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind"
                      ],
                      "properties": {
                        "kind": {
                          "const": "source"
                        }
                      }
                    }
                  ]
                },
                "attestation": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "bundle_url"
                  ],
                  "description": "Solo github_attested: dónde está su firma (bundles/ de este repo)",
                  "properties": {
                    "bundle_url": {
                      "type": "string",
                      "pattern": "^https://"
                    }
                  }
                }
              }
            }
          },
          "project_urls": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^https?://"
            }
          },
          "license": {
            "type": "string",
            "description": "SPDX del repositorio (GitHub)"
          }
        }
      }
    },
    "removed": {
      "$ref": "removed.schema.json"
    },
    "revoked": {
      "$ref": "revoked.schema.json"
    }
  }
}
