{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "revoked.schema.json",
  "title": "Releases revocadas por sus bytes (revoked.json)",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "sha256",
      "date"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "date": {
        "type": "string",
        "format": "date"
      }
    }
  }
}
